<section id="menu" class="menu">
	<div class="container"> 
		<div class="text-center">
			<div class="menu-badge">🍣 Menu Autentik & Lezat</div>
			<h2 class="section-title">Pilihan Menu Rasa Terakhir</h2>
			<p class="section-subtitle">
				Pilih varian dimsum favoritmu dan tentukan paket yang sesuai dengan keinginanmu.
			</p>
		</div>

		<!-- Section 1: Dimsum Premium -->
		<div class="category-header">
			<h3 class="category-title">🍱 Dimsum Premium</h3>
			<p class="category-subtitle">Varian dimsum terbaik dengan bahan-bahan pilihan.</p>
		</div>
		<div class="menu-grid">
			{dimsumMenus.map((menu) => (
				<div class="menu-card" data-name={menu.name} data-packages={JSON.stringify(menu.packages)}>
					<div class="menu-image-container">
						<img src={menu.image} alt={menu.name} loading="lazy" class="menu-img" />
						{menu.badge && <span class="badge">{menu.badge}</span>}
					</div>
					<div class="menu-content">
						<div class="menu-header">
							<h3 class="menu-title">{menu.name}</h3>
							<div class="starting-price">
								Mulai dari <span>Rp {(Math.min(...menu.packages.map(p => p.price))).toLocaleString('id-ID')}</span>
							</div>
						</div>
						<p class="menu-desc">{menu.desc}</p>
						<div class="variant-preview">
							<span>Tersedia {menu.packages.length} Pilihan Paket</span>
						</div>
						<button class="order-btn js-open-modal">
							<span class="icon">🛒</span> Pilih Paket & Pesan
						</button>
					</div>
				</div>
			))}
		</div>

		<!-- Section 2: Jajanan Lainnya -->
		<div class="category-header second">
			<h3 class="category-title">🍡 Aneka Jajanan</h3>
			<p class="category-subtitle">Camilan lezat pendamping setia momen santaimu.</p>
		</div>
		<div class="menu-grid">
			{snackMenus.map((menu) => (
				<div class="menu-card" data-name={menu.name} data-packages={JSON.stringify(menu.packages)}>
					<div class="menu-image-container">
						<img src={menu.image} alt={menu.name} loading="lazy" class="menu-img" />
						{menu.badge && <span class="badge secondary">{menu.badge}</span>}
					</div>
					<div class="menu-content">
						<div class="menu-header">
							<h3 class="menu-title">{menu.name}</h3>
							<div class="starting-price">
								Mulai dari <span>Rp {(Math.min(...menu.packages.map(p => p.price))).toLocaleString('id-ID')}</span>
							</div>
						</div>
						<p class="menu-desc">{menu.desc}</p>
						<div class="variant-preview">
							<span>Tersedia {menu.packages.length} Pilihan Paket</span>
						</div>
						<button class="order-btn js-open-modal">
							<span class="icon">🛒</span> Pilih Paket & Pesan
						</button>
					</div>
				</div>
			))}
		</div>
	</div>

	<!-- Modal Structure -->
	<div id="orderModal" class="modal">
		<div class="modal-content">
			<div class="modal-header">
				<h3 id="modalMenuName">Pilih Paket</h3>
				<button class="close-modal">&times;</button>
			</div>
			<div class="modal-body">
				<p class="modal-instruction">✨ Pilih varian paket yang Anda inginkan:</p>
				
				<div class="form-group">
					<label>Varian Paket:</label>
					<div id="packageOptions" class="package-options">
						<!-- Dynamic package buttons -->
					</div>
				</div>

				<div class="form-group">
					<label>Jumlah Pesanan:</label>
					<div class="quantity-control">
						<button type="button" class="qty-btn" id="minusBtn">-</button>
						<input type="number" id="orderQty" value="1" min="1">
						<button type="button" class="qty-btn" id="plusBtn">+</button>
					</div>
				</div>

				<div class="total-section">
					<span>Total Harga:</span>
					<span id="totalDisplay">Rp 0</span>
				</div>
			</div>
			<div class="modal-footer">
				<button id="confirmOrderBtn" class="confirm-btn">
					<span class="wa-icon">📱</span> Kirim Pesanan ke WhatsApp
				</button>
			</div>
		</div>
	</div>
</section>

