</style>

<script>
	// Function to initialize modal logic
	function initModal() {
		const modal = document.getElementById('orderModal');
		const closeButtons = document.querySelectorAll('.close-modal');
		const packageOptions = document.getElementById('packageOptions');
		const qtyInput = document.getElementById('orderQty');
		const totalDisplay = document.getElementById('totalDisplay');
		const confirmBtn = document.getElementById('confirmOrderBtn');
		
		if (!modal || !packageOptions || !qtyInput || !totalDisplay || !confirmBtn) {
			console.error('Modal elements not found');
			return;
		}

		let currentMenuName = '';
		let currentPackages = [];
		let selectedPackageIndex = 0;
		let currentQty = 1;

		function updateTotal() {
			if (!currentPackages[selectedPackageIndex]) return;
			const price = currentPackages[selectedPackageIndex].price;
			const total = price * currentQty;
			totalDisplay.textContent = `Rp ${total.toLocaleString()}`;
		}

		function selectPackage(index) {
			selectedPackageIndex = index;
			document.querySelectorAll('.package-opt').forEach((opt, i) => {
				opt.classList.toggle('active', i === index);
			});
			updateTotal();
		}

		// Open Modal
		document.querySelectorAll('.js-open-modal').forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				const card = btn.closest('.menu-card');
				if (!card) return;

				currentMenuName = card.dataset.name;
				try {
					currentPackages = JSON.parse(card.dataset.packages);
				} catch (err) {
					console.error('Failed to parse packages', err);
					return;
				}
				
				document.getElementById('modalMenuName').textContent = currentMenuName;
				
				// Render packages
				packageOptions.innerHTML = '';
				currentPackages.forEach((pkg, index) => {
					const opt = document.createElement('div');
					opt.className = `package-opt ${index === 0 ? 'active' : ''}`;
					opt.innerHTML = `
						<span class="pkg-name">${pkg.name}</span>
						<span class="pkg-price">Rp ${pkg.price.toLocaleString()}</span>
					`;
					opt.addEventListener('click', () => selectPackage(index));
					packageOptions.appendChild(opt);
				});

				selectedPackageIndex = 0;
				currentQty = 1;
				qtyInput.value = 1;
				updateTotal();
				
				modal.style.display = 'flex';
				document.body.style.overflow = 'hidden';
			});
		});

		// Qty controls
		const plusBtn = document.getElementById('plusBtn');
		const minusBtn = document.getElementById('minusBtn');

		if (plusBtn) {
			plusBtn.onclick = () => {
				currentQty++;
				qtyInput.value = currentQty;
				updateTotal();
			};
		}

		if (minusBtn) {
			minusBtn.onclick = () => {
				if (currentQty > 1) {
					currentQty--;
					qtyInput.value = currentQty;
					updateTotal();
				}
			};
		}

		qtyInput.onchange = (e) => {
			currentQty = Math.max(1, parseInt(e.target.value) || 1);
			qtyInput.value = currentQty;
			updateTotal();
		};

		// Close Modal
		closeButtons.forEach(btn => {
			btn.onclick = () => {
				modal.style.display = 'none';
				document.body.style.overflow = '';
			};
		});

		window.addEventListener('click', (e) => {
			if (e.target === modal) {
				modal.style.display = 'none';
				document.body.style.overflow = '';
			}
		});

		// Handle WA Order
		confirmBtn.onclick = () => {
			const pkg = currentPackages[selectedPackageIndex];
			const total = pkg.price * currentQty;
			const message = `Halo Mas Azis (Rasa Terakhir) 👋\n\nSaya ingin memesan:\n🍱 *${currentMenuName}*\n📦 *${pkg.name}*\n🔢 Jumlah: *${currentQty} Porsi*\n\n💰 Total Harga: *Rp ${total.toLocaleString()}*\n\nTerima kasih!`;
			
			const waUrl = `https://wa.me/62882017479270?text=${encodeURIComponent(message)}`;
			window.open(waUrl, '_blank');
		};
	}

	// Run on initial load
	initModal();

	// Support for View Transitions if enabled later
	document.addEventListener('astro:page-load', initModal);
</script>

