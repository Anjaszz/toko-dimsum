---
// Delivery.astro
---

<section id="delivery" class="delivery">
	<div class="delivery-bg">
		<div class="delivery-glow d1"></div>
		<div class="delivery-glow d2"></div>
	</div>

	<div class="container">
		<div class="text-center animate-on-scroll">
			<div class="delivery-badge">🚀 Pesan Lebih Mudah</div>
			<h2 class="section-title">Nikmati di Mana Saja</h2>
			<p class="section-subtitle">
				Dimsum premium <strong>Rasa Terakhir</strong> kini tersedia di platform delivery favorit Anda. Cepat, hangat, dan sampai di depan pintu Anda.
			</p>
		</div>

		<div class="delivery-platforms">
			<!-- GrabFood -->
			<a href="https://food.grab.com/id/id/" target="_blank" class="platform-card grab" aria-label="Pesan via GrabFood">
				<div class="card-glass"></div>
				<div class="logo-wrapper">
					<img src="/logo/logo-grabfood.png" alt="GrabFood Logo" class="platform-logo" />
				</div>
				<span class="platform-name">GrabFood</span>
				<div class="order-now">
					<span>Pesan Sekarang</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
				</div>
			</a>

			<!-- ShopeeFood -->
			<a href="https://spf.shopee.co.id/9paOZh6XVJ" target="_blank" class="platform-card shopee" aria-label="Pesan via ShopeeFood">
				<div class="card-glass"></div>
				<div class="logo-wrapper">
					<img src="/logo/Shopee%20Food%20Logo.png" alt="ShopeeFood Logo" class="platform-logo" />
				</div>
				<span class="platform-name">ShopeeFood</span>
				<div class="order-now">
					<span>Pesan Sekarang</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
				</div>
			</a>

			<!-- GoFood -->
			<a href="https://gofood.co.id/serang/restaurant/rasa-terakhir-by-mas-azis-179e8620-6180-489c-87af-e6fb094c674f" target="_blank" class="platform-card gofood" aria-label="Pesan via GoFood">
				<div class="card-glass"></div>
				<div class="logo-wrapper">
					<img src="/logo/logo-gofood.png" alt="GoFood Logo" class="platform-logo" />
				</div>
				<span class="platform-name">GoFood</span>
				<div class="order-now">
					<span>Pesan Sekarang</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
				</div>
			</a>
		</div>
	</div>
</section>

<style>
	.delivery {
		background-color: var(--bg-light);
		position: relative;
		overflow: hidden;
		padding: 120px 0;
	}

	.delivery-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.delivery-glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(100px);
		opacity: 0.12;
	}

	.d1 {
		top: 10%;
		right: 15%;
		width: 400px;
		height: 400px;
		background: radial-gradient(circle, #00B14F 0%, transparent 70%);
	}

	.d2 {
		bottom: 10%;
		left: 10%;
		width: 350px;
		height: 350px;
		background: radial-gradient(circle, #EE4D2D 0%, transparent 70%);
	}

	.delivery-badge {
		display: inline-block;
		padding: 8px 20px;
		background: rgba(229, 91, 19, 0.1);
		border: 1px solid rgba(229, 91, 19, 0.2);
		color: var(--primary);
		font-weight: 700;
		border-radius: 50px;
		font-size: 0.9rem;
		margin-bottom: 20px;
		letter-spacing: 0.5px;
	}

	.delivery-platforms {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 30px;
		margin-top: 60px;
		position: relative;
		z-index: 10;
	}

	.platform-card {
		position: relative;
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.05);
		border-radius: 40px;
		padding: 50px 30px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		transition: var(--transition);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
		overflow: hidden;
		text-decoration: none;
	}

	.card-glass {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.6) 100%);
		z-index: -1;
	}

	.platform-card:hover {
		transform: translateY(-12px);
		box-shadow: 0 30px 60px rgba(112, 51, 16, 0.1);
	}

	.logo-wrapper {
		width: 140px;
		height: 140px;
		background: #fdfdfd;
		border-radius: 30px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 25px;
		padding: 20px;
		box-shadow: inset 0 2px 10px rgba(0,0,0,0.02);
		transition: var(--transition);
	}

	.platform-card:hover .logo-wrapper {
		background: #ffffff;
		transform: scale(1.05);
		box-shadow: 0 10px 20px rgba(0,0,0,0.05);
	}

	.platform-logo {
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.platform-card:hover .platform-logo {
		transform: scale(1.15);
	}

	.platform-name {
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--secondary);
		margin-bottom: 20px;
		letter-spacing: -0.5px;
	}

	.order-now {
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--text-muted);
		transition: var(--transition);
	}

	.platform-card:hover .order-now {
		color: var(--primary);
	}

	.order-now svg {
		transition: transform 0.3s ease;
	}

	.platform-card:hover .order-now svg {
		transform: translateX(6px);
	}

	/* Theme Specific Borders on Hover */
	.grab:hover { border-color: #00B14F; }
	.shopee:hover { border-color: #EE4D2D; }
	.gofood:hover { border-color: #EE2737; }

	@media (max-width: 992px) {
		.delivery-platforms {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.delivery {
			padding: 80px 0;
		}

		.delivery-platforms {
			grid-template-columns: 1fr;
			gap: 20px;
		}
		
		.platform-card {
			padding: 40px 20px;
		}
		
		.logo-wrapper {
			width: 120px;
			height: 120px;
		}
	}
</style>

